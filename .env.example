DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
POSTGRES_DB=eudr
POSTGRES_USER=eudr
POSTGRES_PASSWORD=eudr
POSTGRES_HOST=localhost
